# Nonsecret examples; applications do not automatically load this file.
# Omit RIFAD_PORT for api=3000, edge=3001, worker=3002.
RIFAD_ENV=local
RIFAD_HOST=127.0.0.1
# api/worker only, optional: RIFAD_DATABASE_URL, the runtime role (rifad_app) postgres URL with explicit port and database.
# worker only, optional: RIFAD_RELAY_DATABASE_URL (rifad_relay role) and RIFAD_QUEUE_REDIS_URL (dedicated noeviction Redis).
# Loopback servers only; never commit a real value. Edge rejects these settings.
